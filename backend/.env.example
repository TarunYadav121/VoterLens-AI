# VoterLens AI — Backend Environment Configuration

# Flask settings
FLASK_ENV=development
PORT=5000

# AI Insight Assistant Configuration
# AI_PROVIDER: "gemini" | "none" (deterministic only)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=30
